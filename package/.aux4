{
  "scope": "aux4",
  "name": "encrypter",
  "version": "2.0.5",
  "description": "aux4 encryption tool",
  "license": "Apache-2.0",
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "encrypter",
          "execute": [
            "profile:encrypter"
          ],
          "help": {
            "text": "aux4 encrypter"
          }
        }
      ]
    },
    {
      "name": "encrypter",
      "commands": [
        {
          "name": "generate-secret",
          "execute": [
            "${packageDir}/aux4-encrypter generate-secret ${length}"
          ],
          "help": {
            "text": "generate a random secret",
            "variables": [
              {
                "name": "length",
                "text": "the length of the secret",
                "default": "32",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "encrypt",
          "execute": [
            "stdin:${packageDir}/aux4-encrypter encrypt '${secret}' '${iv}' '${text}'"
          ],
          "help": {
            "text": "encrypt a text",
            "variables": [
              {
                "name": "iv",
                "text": "initialization vector",
                "env": "AUX4_IV"
              },
              {
                "name": "secret",
                "text": "secret key",
                "env": "AUX4_SECRET"
              },
              {
                "name": "text",
                "text": "text to encrypt",
                "default": "",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "decrypt",
          "execute": [
            "stdin:${packageDir}/aux4-encrypter decrypt '${secret}' '${iv}' '${text}'"
          ],
          "help": {
            "text": "decrypt a text",
            "variables": [
              {
                "name": "iv",
                "text": "initialization vector",
                "env": "AUX4_IV"
              },
              {
                "name": "secret",
                "text": "secret key",
                "env": "AUX4_SECRET"
              },
              {
                "name": "text",
                "text": "text to decrypt",
                "default": "",
                "arg": true
              }
            ]
          }
        }
      ]
    }
  ]
}
